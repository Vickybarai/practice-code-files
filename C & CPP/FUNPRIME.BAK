#include<stdio.h>
#include<conio.h>
	int prime(a)
	{       int i,b,cnt=0;
		for(i=1;i<=a;i++)
		{
		if(a%2==0)
		{
		cnt++;
		}
		}
	return cnt;
	}

	void main()
	{
	int a,b,i,cnt=0;
	clrscr();
	printf("enter a number:");
	scanf("%d%d",&a,&b);
	for(i=a;i<=b;i++)
	{
		cnt=prime(a)   ;
		if(cnt==2)
		{
		 printf("\n %d",i);
		}

	}
	getch();}


